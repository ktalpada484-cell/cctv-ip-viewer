<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - CCTV Matrix</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>🔐 Admin Portal Login</h1>
    </header>

    <div class="container" style="max-width: 450px; margin-top: 80px;">
        <div class="card">
            <h2>Sign In</h2>
            <% if (error) { %>
                <p style="color: var(--error-red); margin-bottom: 15px; font-size: 0.9rem;"><%= error %></p>
            <% } %>
            <form action="/admin/login" method="POST">
                <div style="margin-bottom: 15px;">
                    <label style="display: block; margin-bottom: 5px; color: var(--text-gray);">Username</label>
                    <input type="text" name="username" placeholder="Enter username" required style="width: 100%;">
                </div>
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 5px; color: var(--text-gray);">Password</label>
                    <input type="password" name="password" placeholder="Enter password" required style="width: 100%;">
                </div>
                <button type="submit" style="width: 100%;">Login to Panel</button>
            </form>
        </div>
    </div>
</body>
</html>

