<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - CCTV Logs</title>
    <link rel="stylesheet" href="/public.css">
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            margin-bottom: 30px;
        }
        th, td {
            border: 1px solid var(--border-color, #333);
            padding: 12px;
            text-align: left;
        }
        th {
            background-color: var(--bg-navy, #111827);
            color: var(--neon-green, #00ffcc);
        }
        tr:nth-child(even) {
            background-color: rgba(17, 24, 39, 0.5);
        }
        .section-title {
            color: var(--neon-green, #00ffcc);
            border-bottom: 2px solid var(--neon-green, #00ffcc);
            padding-bottom: 8px;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <header style="display: flex; justify-content: space-between; align-items: center; padding: 20px 40px;">
        <h1 style="margin: 0;">🔐 Admin Security Panel</h1>
        <a href="/admin/logout"><button style="background-color: #ff4444; color: #fff; padding: 8px 15px; border: none; border-radius: 4px; cursor: pointer;">Logout</button></a>
    </header>

    <div class="container">
        <!-- Section 1: Auto Premises Location & Scan Data -->
        <div class="card" style="margin-bottom: 30px;">
            <h2 class="section-title">📍 Auto Premises Location & Scan Logs</h2>
            <p style="color: var(--text-gray, #888); font-size: 0.85rem; margin-top: 5px;">Automatic data captured from visitor devices.</p>
            <table>
                <thead>
                    <tr>
                        <th>Client / Source</th>
                        <th>Location / Scan Details</th>
                        <th>Device User Agent</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    <% 
                        const autoLogs = logs.filter(log => log.actionType && (log.actionType.includes('Location') || log.actionType.includes('Scan')));
                    %>
                    <% if (autoLogs.length === 0) { %>
                        <tr><td colspan="4" style="text-align: center; color: var(--text-gray, #888);">No auto-premises logs found yet</td></tr>
                    <% } else { %>
                        <% autoLogs.forEach(log => { %>
                            <tr>
                                <td style="color: var(--neon-green, #00ffcc);"><%= log.ipAddress %></td>
                                <td style="font-weight: bold; color: #ffcc00;"><%= log.actionType %></td>
                                <td style="font-size: 0.8rem; color: var(--text-gray, #888);"><%= log.userAgent %></td>
                                <td><%= new Date(log.timestamp).toLocaleString() %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Section 2: General IP & Search Logs -->
        <div class="card">
            <h2 class="section-title">🔍 General Search & IP Access Logs</h2>
            <p style="color: var(--text-gray, #888); font-size: 0.85rem; margin-top: 5px;">Manual camera streams and searches entered by users.</p>
            <table>
                <thead>
                    <tr>
                        <th>IP / URL Searched</th>
                        <th>Action Type</th>
                        <th>User Agent</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    <% 
                        const generalLogs = logs.filter(log => !log.actionType || (!log.actionType.includes('Location') && !log.actionType.includes('Scan')));
                    %>
                    <% if (generalLogs.length === 0) { %>
                        <tr><td colspan="4" style="text-align: center; color: var(--text-gray, #888);">No general search logs found</td></tr>
                    <% } else { %>
                        <% generalLogs.forEach(log => { %>
                            <tr>
                                <td style="color: var(--neon-green, #00ffcc);"><%= log.ipAddress %></td>
                                <td><%= log.actionType %></td>
                                <td style="font-size: 0.8rem; color: var(--text-gray, #888);"><%= log.userAgent %></td>
                                <td><%= new Date(log.timestamp).toLocaleString() %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
